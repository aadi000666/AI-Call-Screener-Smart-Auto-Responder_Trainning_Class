# ============================================================
# AI Call Screener & Smart Auto-Responder - Environment Template
# Copy this file to .env and fill in your keys.
# ============================================================

# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary LLM Provider: 'ollama' or 'gemini'
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# User Information
USER_NAME=Aditya

# Operational Mode: 'smart_reject' | 'voice_screen' | 'vip_bypass'
ACTIVE_MODE=smart_reject

# Android ADB Wireless Settings
ADB_DEVICE_IP=192.168.1.100
ADB_DEVICE_PORT=5555

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017

# Voice Engine Settings
TTS_VOICE=en-IN-NeerjaNeural
